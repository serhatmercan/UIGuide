<mvc:View
    xmlns="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    controllerName="xxx.controller.Object"
>
    <ObjectPageLayout showFooter="{model>/ObjectFooterVisible}">
        <headerTitle>
            <core:Fragment
                fragmentName="xxx.fragments.view.object.HeaderTitle"
                type="XML"
            />
        </headerTitle>
        <headerContent>
            <core:Fragment
                fragmentName="xxx.fragments.view.object.HeaderContent"
                type="XML"
            />
        </headerContent>
        <sections>
            <ObjectPageSection
                showTitle="true"
                titleUppercase="false"
            >
                <subSections>
                    <ObjectPageSubSection
                        title="{i18n>information}"
                        titleUppercase="false"
                    >
                        <blocks>
                            <core:Fragment
                                fragmentName="xxx.fragments.view.object.Information"
                                type="XML"
                            />
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
            <ObjectPageSection
                showTitle="true"
                titleUppercase="false"
            >
                <subSections>
                    <ObjectPageSubSection
                        title="{i18n>items}"
                        titleUppercase="false"
                    >
                        <blocks>
                            <core:Fragment
                                fragmentName="xxx.fragments.view.object.InformationItems"
                                type="XML"
                            />
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
        <footer>
            <core:Fragment
                fragmentName="xxx.fragments.view.object.Footer"
                type="XML"
            />
        </footer>
    </ObjectPageLayout>
</mvc:View>
